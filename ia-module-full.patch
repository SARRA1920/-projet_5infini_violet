+}
+.sentiment-score strong.up {
+  color: #16a085;
+}
+.sentiment-score strong.down {
+  color: #c0392b;
+}
+.sentiment-bar {
+  height: 8px;
+  background: linear-gradient(90deg, #c0392b, #eee 50%, #16a085);
+  border-radius: 4px;
+  overflow: hidden;
+  position: relative;
+}
+.sentiment-bar-fill {
+  position: absolute;
+  left: 0;
+  top: 0;
+  height: 100%;
+  background: rgba(41, 128, 185, 0.25);
+  border-right: 2px solid #2980b9;
+}
+.sentiment-source {
+  font-size: 0.8rem;
+  color: var(--muted, #6f7d92);
+}
+.headline-list {
+  list-style: none;
+  padding: 0;
+  display: flex;
+  flex-direction: column;
+  gap: 0.4rem;
+}
+.headline-list li {
+  display: flex;
+  justify-content: space-between;
+  gap: 1rem;
+  padding: 0.5rem 0.75rem;
+  background: var(--surface, #f8f9fb);
+  border-radius: 6px;
+  font-size: 0.9rem;
+}
+.headline-list em {
+  font-style: normal;
+  font-weight: 600;
+  white-space: nowrap;
+}
+.headline-list em.up {
+  color: #16a085;
+}
+.headline-list em.down {
+  color: #c0392b;
+}
+
+/* ---- Agent ---- */
+.agent-result {
+  display: flex;
+  flex-direction: column;
+  gap: 1.25rem;
+}
+.agent-action {
+  display: flex;
+  align-items: center;
+  gap: 1rem;
+  padding: 1rem 1.5rem;
+  border-radius: 12px;
+  background: #eee;
+  color: #555;
+}
+.agent-action.up {
+  background: #d4f4dd;
+  color: #16a085;
+}
+.agent-action.down {
+  background: #fde0dc;
+  color: #c0392b;
+}
+.agent-action .action-label {
+  font-size: 1.5rem;
+  font-weight: 800;
+}
+.agent-action .action-symbol {
+  font-size: 1.1rem;
+  font-weight: 600;
+  opacity: 0.8;
+}
+
+.agent-reasons h3 {
+  margin: 0 0 0.5rem;
+  font-size: 1rem;
+}
+.reason-list {
+  list-style: none;
+  padding: 0;
+  display: flex;
+  flex-direction: column;
+  gap: 0.4rem;
+}
+.reason-list li {
+  display: grid;
+  grid-template-columns: 100px 1fr 70px;
+  gap: 0.75rem;
+  align-items: center;
+  padding: 0.6rem 0.8rem;
+  background: var(--surface, #f8f9fb);
+  border-radius: 6px;
+  font-size: 0.9rem;
+}
+.reason-signal {
+  font-weight: 700;
+  color: #2980b9;
+  text-transform: capitalize;
+}
+.reason-detail {
+  color: var(--text, #2c3e50);
+}
+.reason-contrib {
+  text-align: right;
+  font-weight: 700;
+  font-variant-numeric: tabular-nums;
+}
+.reason-contrib.up {
+  color: #16a085;
+}
+.reason-contrib.down {
+  color: #c0392b;
+}
+.reason-total {
+  margin-top: 0.75rem;
+  padding: 0.6rem 0.8rem;
+  background: #eef5fc;
+  border-radius: 6px;
+  font-size: 0.9rem;
+  display: flex;
+  align-items: center;
+  gap: 0.5rem;
+  flex-wrap: wrap;
+}
+.reason-total strong {
+  font-size: 1.1rem;
+}
+.reason-total strong.up {
+  color: #16a085;
+}
+.reason-total strong.down {
+  color: #c0392b;
+}
+.reason-threshold {
+  font-size: 0.8rem;
+  color: var(--muted, #6f7d92);
+}
+
+/* ---- Responsive ---- */
+@media (max-width: 640px) {
+  .ia-form {
+    flex-direction: column;
+    align-items: stretch;
+  }
+  .ia-form input,
+  .ia-form select {
+    min-width: 0;
+    width: 100%;
+  }
+  .reason-list li {
+    grid-template-columns: 1fr;
+    gap: 0.3rem;
+  }
+  .reason-contrib {
+    text-align: left;
+  }
+}
diff --git a/frontend/src/services/ia.js b/frontend/src/services/ia.js
new file mode 100644
index 0000000..849d9d1
--- /dev/null
+++ b/frontend/src/services/ia.js
@@ -0,0 +1,43 @@
+// Module IA : appels API vers /api/ia et formatage.
+// Les rendements et scores arrivent en fractions (0.023 = 2,3 %).
+import { api } from "./api.js";
+
+export function iaApi(path, params) {
+  const query = params ? `?${new URLSearchParams(params)}` : "";
+  return api(`/api/ia${path}${query}`);
+}
+
+export function postIa(path, body) {
+  return api(`/api/ia${path}`, { method: "POST", body: JSON.stringify(body) });
+}
+
+const percent = new Intl.NumberFormat("fr-FR", {
+  style: "percent",
+  minimumFractionDigits: 2,
+  maximumFractionDigits: 2,
+});
+const price = new Intl.NumberFormat("fr-FR", {
+  minimumFractionDigits: 2,
+  maximumFractionDigits: 2,
+});
+
+const missing = (value) => value === null || value === undefined || Number.isNaN(value);
+
+export const fmtPct = (value) => (missing(value) ? "—" : percent.format(value));
+export const fmtPrice = (value) => (missing(value) ? "—" : price.format(value));
+export const toneOf = (value) => (missing(value) || value === 0 ? "" : value > 0 ? "up" : "down");
+
+// Étiquettes lisibles pour les actions et labels de sentiment.
+export const ACTION_LABELS = { BUY: "Acheter", SELL: "Vendre", HOLD: "Conserver" };
+export const ACTION_TONES = { BUY: "up", SELL: "down", HOLD: "" };
+export const SENTIMENT_LABELS = { positif: "Positif", neutre: "Neutre", négatif: "Négatif" };
+export const SENTIMENT_TONES = { positif: "up", neutre: "", négatif: "down" };
+
+// Horizons proposés à l'utilisateur (en jours).
