+.status-list em {
+  font-style: normal;
+  font-weight: 600;
+}
+.status-list em.ok {
+  color: #16a085;
+}
+.status-list em.ko {
+  color: #c0392b;
+}
+
+.ia-cards {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
