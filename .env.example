# Copier ce fichier en .env et remplacer les valeurs (ne jamais commiter .env)
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme

# Dans docker-compose, le backend reçoit ses propres URLs (hôtes "db" et "redis").
# Celles-ci servent à lancer le backend ou Alembic hors Docker.
DATABASE_URL=postgresql://changeme:changeme@localhost:5432/salle_marche
REDIS_URL=redis://localhost:6379/0

# Secret pour signer les jetons JWT. Longue chaîne aléatoire, locale à votre PC.
JWT_SECRET=changeme

# Clé API Twelve Data (https://twelvedata.com) pour importer les cours réels
TWELVEDATA_API_KEY=
