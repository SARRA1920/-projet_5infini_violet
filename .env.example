# Copier ce fichier en .env et remplacer les valeurs (ne jamais commiter .env)
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme

# Dans docker-compose, le backend reçoit ses propres URLs (hôtes "db" et "redis").
# Celles-ci servent à lancer le backend ou Alembic hors Docker.
DATABASE_URL=postgresql://changeme:changeme@localhost:5432/salle_marche
REDIS_URL=redis://localhost:6379/0

# Secret pour signer les jetons JWT. Longue chaîne aléatoire, locale à votre PC.
# Générer : docker compose exec backend python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Mot de passe local des comptes de démo (test@example.com, admin@example.com).
SEED_PASSWORD=

# Clé API Twelve Data (https://twelvedata.com) pour importer les cours réels
TWELVEDATA_API_KEY=

# Envoi du lien « mot de passe oublié ». Avec Gmail : un mot de passe d'application,
# pas le mot de passe du compte. SMTP_FROM peut rester vide : SMTP_USER est utilisé.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
APP_PUBLIC_URL=http://localhost:3000
